# Mock mode is the default and does not require secrets.
LUMEN_AI_PROVIDER=mock

# Enable this when testing the real OpenAI provider locally.
# LUMEN_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-replace-me

# Optional model overrides. Defaults live in src/ai/openAiProviderConfig.ts.
# LUMEN_OPENAI_REWRITE_MODEL=gpt-5-mini
# LUMEN_OPENAI_THEME_MODEL=gpt-5-mini
# LUMEN_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional Supabase server integration (M1 foundation).
# Shared cloud Supabase is the default prelaunch path for local + CI when enabled.
# LUMEN_USE_SUPABASE=true
# LUMEN_SUPABASE_URL=https://your-project-ref.supabase.co
# Flutter web/client auth builds also need the client-safe publishable
# key when LUMEN_USE_SUPABASE=true.
# LUMEN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Use a server-only secret key only if the API needs privileged Supabase access.
# LUMEN_SUPABASE_SECRET_KEY=sb_secret_replace_me
# LUMEN_SUPABASE_DB_URL=postgresql://postgres.<project-ref>:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# CI deploys repo migrations to the shared cloud project on push to master.

# Production configuration ownership inventory:
# docs/production-config-inventory.md
